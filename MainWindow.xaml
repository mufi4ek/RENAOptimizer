<Window x:Class="RENAOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RENA Optimizer" Height="600" Width="950"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <Border Background="#070707" CornerRadius="20" BorderBrush="#1A1A1A" BorderThickness="2">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель -->
            <Border Background="#0A0A0A" CornerRadius="20,0,0,20">
                <StackPanel Margin="0,30,0,0">
                    <TextBlock Text="RENA" FontSize="36" FontWeight="ExtraBold" Foreground="#BB86FC" HorizontalAlignment="Center" Margin="0,0,0,50">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#BB86FC" BlurRadius="15" ShadowDepth="0"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    
                    <Button Content="DASHBOARD" Style="{StaticResource NavButton}"/>
                    <Button Content="OPTIMIZER" Style="{StaticResource NavButton}"/>
                    <Button Content="CLEANER" Style="{StaticResource NavButton}"/>
                    
                    <Button Content="EXIT" Click="ExitApp" Margin="0,200,0,0" Foreground="#CF6679" Background="Transparent" BorderThickness="0" Cursor="Hand" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <!-- Основная часть -->
            <Grid Grid.Column="1" Margin="40">
                <StackPanel>
                    <TextBlock Text="SYSTEM STATUS" FontSize="12" Foreground="#555" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Text="Performance Dashboard" FontSize="32" Foreground="White" FontWeight="Bold" Margin="0,0,0,30"/>

                    <UniformGrid Columns="2" Margin="0,0,0=">
                        <Border Background="#111" Margin="5" CornerRadius="15" Padding="20" BorderBrush="#222" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Quick Boost" FontSize="18" Foreground="White" FontWeight="Bold"/>
                                <TextBlock Text="Essential gaming tweaks" Foreground="#666" FontSize="12" Margin="0,5,0,15"/>
                                <Button Content="RUN NOW" Background="#BB86FC" Foreground="Black" FontWeight="Bold" Height="35" Click="RunOptimize_Click" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Border>
                        
                        <Border Background="#111" Margin="5" CornerRadius="15" Padding="20" BorderBrush="#222" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Deep Clean" FontSize="18" Foreground="White" FontWeight="Bold"/>
                                <TextBlock Text="Clear system junk" Foreground="#666" FontSize="12" Margin="0,5,0,15"/>
                                <Button Content="CLEAN" Background="Transparent" BorderBrush="#BB86FC" BorderThickness="1" Foreground="#BB86FC" FontWeight="Bold" Height="35" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <TextBlock x:Name="StatusText" Text="Ready to optimize." Foreground="#BB86FC" HorizontalAlignment="Center" Margin="0,30,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>

    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
</Window>
