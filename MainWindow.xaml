<Window x:Class="RENAOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RENA Optimizer" Height="550" Width="900"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <Border Background="#0A0A0A" CornerRadius="15" BorderBrush="#222" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Боковая панель -->
            <Border Background="#0D0D0D" CornerRadius="15,0,0,15">
                <StackPanel Margin="20">
                    <TextBlock Text="RENA" FontSize="32" FontWeight="Bold" Foreground="#BB86FC" Margin="0,0,0,40"/>
                    
                    <Button Content="DASHBOARD" Foreground="White" Background="Transparent" BorderThickness="0" Height="40" HorizontalContentAlignment="Left" Cursor="Hand"/>
                    <Button Content="OPTIMIZATION" Foreground="White" Background="Transparent" BorderThickness="0" Height="40" HorizontalContentAlignment="Left" Cursor="Hand"/>
                    <Button Content="CLEANER" Foreground="White" Background="Transparent" BorderThickness="0" Height="40" HorizontalContentAlignment="Left" Cursor="Hand"/>
                    
                    <Button Content="EXIT" Click="ExitApp" Margin="0,180,0,0" Foreground="#CF6679" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Border>

            <!-- Контент -->
            <StackPanel Grid.Column="1" Margin="40">
                <TextBlock Text="System Optimization" FontSize="24" Foreground="White" FontWeight="Bold"/>
                <TextBlock Text="Boost your PC performance to the limit" Foreground="#888" Margin="0,5,0,30"/>

                <!-- Карточка действия -->
                <Border Background="#121212" CornerRadius="10" Padding="20">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Ultimate Boost" FontSize="18" Foreground="White"/>
                            <TextBlock Text="Apply all gaming tweaks (Game Mode, Power Plan, RAM)" Foreground="#666" FontSize="12" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Button Content="RUN OPTIMIZER" HorizontalAlignment="Right" VerticalAlignment="Center" 
                                Width="140" Height="40" Background="#BB86FC" Foreground="Black" FontWeight="Bold"
                                Click="RunOptimize_Click">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>

                <!-- Статус бар -->
                <TextBlock x:Name="StatusText" Text="Ready to boost..." Foreground="#BB86FC" Margin="0,20,0,0" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Кнопка закрытия (крестик) -->
            <Button Grid.Column="1" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" 
                    Background="Transparent" Foreground="White" BorderThickness="0" Margin="10" Click="ExitApp"/>
        </Grid>
    </Border>
</Window>